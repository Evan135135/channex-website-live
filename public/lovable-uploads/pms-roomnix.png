              <h5 class="card-title fw-semibold mb-3">Standard Plan</h5>

              <div class="mb-3">
                <div class="btn-group" role="group">
                  <input type="radio" class="btn-check" name="billingStandard" id="standardYearly" checked>
                  <label class="btn btn-outline-primary billing-active" for="standardYearly">
                    Yearly                  </label>
                </div>
              </div>

              <div class="mb-3">
                <label for="propertyTypeStandard" class="form-label">
                  Property type                </label>
                <select id="propertyTypeStandard" class="form-select w-75 mx-auto property-type-select">
                  <option value="hotel">Hotel</option>

<!-- Hero Section -->
<section id="hero" class="hero airbnb-hero">
  <div class="container hero-flex">

    <!-- LEFT SIDE -->
    <div class="hero-content">
      <h1 class="hero-title">
        The simplest way to manage your property.      </h1>

      <p class="hero-subtitle">
        Roomnix helps hotels, hostels, villas & apartments, and camping/RV parks run smoothly with an intuitive calendar, fast check-in, online bookings, and effortless billing.      </p>

      <p class="visually-hidden">
        Roomnix is a cloud property management system for hotels, hostels, apartments and camping sites.      </p>

      <div id="demo" class="hero-buttons">
        <a href="https://app.roomnix.com/index.php?demo=1"
          class="btn btn-primary btn-lg hero-main-btn"
          target="_blank"
          rel="noopener noreferrer">
          Try Live Demo        </a>

        <a href="#features" class="btn btn-outline-secondary btn-lg hero-secondary-btn">
          See Features        </a>
      </div>
    </div>

    <!-- RIGHT SIDE (Image) -->
    <div class="hero-image-wrapper">
      <img
        src="/images/dashboard.webp"
        alt="Roomnix PMS dashboard screenshot"
        class="hero-image"
        width="1200"
        height="750"
        decoding="async"
        fetchpriority="high">
    </div>
  </div>
</section>

<!-- Channel Logos / Trust Strip -->
<section id="trustChannels" class="trust-channels py-4 pb-5">
  <div class="container">
    <!-- Logo row -->
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mb-3">
      <div class="trust-channels-text small text-muted fw-semibold text-uppercase">
        Channel partners      </div>

      <div class="trust-channels-logos d-flex align-items-center flex-wrap gap-3">

                This helps us configure Roomnix for your inventory (rooms, beds, units, or pitches).              </div>
            </div>

            <!-- Pro Degressive Price Calculator -->
            <div class="plan-calc-box mb-3">
              <div class="plan-calc-label inventory-label" data-for="Pro">
                Number of units              </div>
              <div class="plan-slider-row">
                <input type="range" id="roomSliderPro" min="1" max="99" value="10">
                <div class="plan-slider-val" id="proSliderDisplay">10</div>
              </div>
              <div class="plan-slider-ends">
                <span>1 &mdash; min 10 billed</span>
                <span>99 max</span>
              </div>
              <div class="plan-price-display" id="proAnnualTotal"></div>

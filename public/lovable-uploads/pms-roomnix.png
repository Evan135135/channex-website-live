                  <div class="plan-slider-val" id="standardSliderDisplay">10</div>
                </div>
                <div class="plan-slider-ends">
                  <span>1</span><span>99 max</span>
                </div>
                <div class="plan-price-display">
                  <span class="plan-price-amount is-free">Free</span>
                  <span class="plan-price-unit">/ year</span>
                </div>
              </div>

              <div class="mb-4">
                <span class="d-block small text-muted mb-1">
                  Commission rate                </span>
                <span class="commission-value display-6 fw-bold text-success">
                  3%
                </span>
                <span class="d-block small text-muted mt-1">
                  Per booking via Roomnix Booking Engine.<br>
                  If you dont want to use the Booking Engine, the PMS remains completely free.                </span>
              </div>

              <ul class="list-unstyled text-muted mb-4 feature-list">
                <li>Hotel Management System (HMS)</li>
                <li>Booking Engine</li>
                <li>Invoicing System</li>
                <li>Website Builder</li>
              </ul>

              <a href="#"
                 id="standardSubscribeBtn"
                 class="btn btn-primary hero-main-btn w-100"
                 data-commission="3">
                Subscribe Now              </a>
            </div>
          </div>
        </div>
      
      <div class="col-md-6">
        <div class="card border-0 shadow-lg h-100 rounded-4 position-relative">
          <div class="position-absolute top-0 start-50 translate-middle-x"
               style="transform: translate(-50%, -50%); z-index: 1;">
            <span class="badge bg-outline-primary hero-main-btn p-2 px-3 rounded-pill me-1">
              Recommended            </span>
          </div>

          <div class="card-body d-flex flex-column justify-content-between text-center py-5 px-4">
            <h5 class="card-title fw-semibold text-secondary mb-3">Pro Plan</h5>

            <div class="mb-3">
              <div class="btn-group" role="group">
                <input type="radio" class="btn-check" name="billingPro" id="proYearly" checked>
                <label class="btn btn-outline-primary billing-active" for="proYearly">
                  Yearly                </label>
              </div>
            </div>

            <div class="mb-3">
              <label for="propertyTypePro" class="form-label">

<!-- Pricing -->
<section id="pricing" class="pricing py-5" style="background-color: #fcedeb;">
  <div class="container">
    <h2 class="text-center mb-4 fw-bold" style="font-family: 'Rubik', sans-serif;">
      Pricing    </h2>

    <p class="text-center text-muted mb-5">
      Flexible plans for every property size    </p>

    <div class="pricing-transparency text-center mb-4">
      <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3 flex-wrap flex-md-nowrap">
        <div><i class="bi bi-check-circle-fill text-success me-2"></i>Inventory-based pricing</div>
        <div><i class="bi bi-check-circle-fill text-success me-2"></i>Cancel anytime - no contract</div>
        <div><i class="bi bi-check-circle-fill text-success me-2"></i>Migration support included</div>
      </div>
    </div>

    <div class="row justify-content-center g-4 align-items-stretch">
              <div class="col-md-6">
          <div class="card border-0 shadow-lg h-100 rounded-4 position-relative">
            <div class="position-absolute top-0 start-50 translate-middle-x"
                 style="transform: translate(-50%, -50%); z-index: 1;">
              <span class="badge bg-outline-primary hero-main-btn p-2 px-3 rounded-pill">
